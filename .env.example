# Required: PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: server-side AI provider (OpenAI-compatible - OpenAI itself, or a
# gateway such as OpenRouter that speaks the same chat-completions format).
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Optional: a cheaper/free-tier model id on the same key (e.g. an OpenRouter
# ":free" model) to try first, on a short timeout, before AI_MODEL. Leave
# blank to always use AI_MODEL directly.
AI_FREE_MODEL=

# Optional: Stripe. Leave blank if payments are not configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Explicit development-only payment adapter. Never enable in production.
PAYMENTS_DEMO_MODE=false

# Canonical public application origin. Required in production for OAuth/payment redirects.
# Must be HTTPS in production, e.g. https://my-sindbad.example.com
APP_BASE_URL=

# Google sign-in (OAuth 2.0 / OpenID Connect)
# Create a Web application OAuth client in Google Cloud.
# Authorized redirect URI: <APP_BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Backwards-compatible alias for APP_BASE_URL. Prefer APP_BASE_URL for new deployments.
AUTH_BASE_URL=

# Map tiles. Development falls back to the public OSM raster endpoint for local QA only.
# Production must configure a dedicated/self-hosted HTTPS tile URL and its required attribution.
# Example URL template: https://tiles.example.com/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# Route directions ("Take me there"). Names only - never commit values.
# ROUTING_PROVIDER: "geoapify" or "osrm". Unset = Geoapify when GEOAPIFY_API_KEY is set, otherwise osrm.
# There is NO automatic fallback between providers.
ROUTING_PROVIDER=
# Geoapify Routing API (server-side only; never exposed to the browser or logged).
GEOAPIFY_API_KEY=
# Free-plan protection. Daily credits this app may spend (plan allows 3000; default 400) and
# requests per second (plan allows 5; default and maximum 2 - see budget.ts for why). Counted in the shared PostgreSQL table.
GEOAPIFY_DAILY_BUDGET=
GEOAPIFY_MAX_PER_SECOND=
# Longest route, in km, the app will request (default 300, max 450; 500+ km costs extra credits).
GEOAPIFY_MAX_ROUTE_KM=
# Test-only override of the Geoapify base URL. Ignored in production.
GEOAPIFY_BASE_URL=
# Emergency stop: true = no route request leaves the server.
ROUTING_KILL_SWITCH=
# OSRM-compatible servers (self-hosted). The community instance is refused in production
# unless ROUTING_ALLOW_PUBLIC_EXPERIMENTAL=true (free, 1 request/s for everyone, no uptime guarantee).
ROUTING_OSRM_URL=
ROUTING_WALKING_URL=
ROUTING_DRIVING_URL=
ROUTING_ALLOW_PUBLIC_EXPERIMENTAL=
